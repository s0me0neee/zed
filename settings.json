// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "terminal": {
    "dock": "bottom"
  },
  "agent": {
    "button": true,
    "model_parameters": []
  },
  "collaboration_panel": {
    "button": false
  },
  "outline_panel": {
    "git_status": false
  },
  "zoomed_padding": false,
  "active_pane_modifiers": {
    "border_size": 0.0,
    "inactive_opacity": 1.0
  },
  "bottom_dock_layout": "contained",
  "show_edit_predictions": false,
  "tabs": {
    "show_close_button": "hover",
    "show_diagnostics": "all",
    "file_icons": true,
    "git_status": false
  },
  "tab_bar": {
    "show": true
  },
  "title_bar": {
    "show_menus": false,
    "show_user_picture": false,
    "show_onboarding_banner": false,
    "show_project_items": true,
    "show_branch_name": true,
    "show_branch_icon": false
  },
  "debugger": {
    "button": false
  },
  "search": {
    "button": false
  },
  "status_bar": {
    "cursor_position_button": false,
    "active_language_button": true
  },
  "project_panel": {
    "hide_hidden": false,
    "hide_root": true,
    "indent_guides": {
      "show": "never"
    },
    "scrollbar": {
      "show": "auto"
    },
    "auto_reveal_entries": true,
    "git_status": false,
    "folder_icons": true,
    "file_icons": true,
    "entry_spacing": "comfortable",
    "default_width": 240.0,
    "dock": "left",
    "button": true
  },
  "diagnostics": {
    "button": false,
    "inline": {
      "padding": 4,
      "update_debounce_ms": 100,
      "enabled": true
    }
  },
  "prettier": {
    "allowed": false
  },
  "completions": {
    "lsp_insert_mode": "insert",
    "lsp_fetch_timeout_ms": 0
  },
  "middle_click_paste": false,
  "lsp_document_colors": "inlay",
  "inlay_hints": {
    "scroll_debounce_ms": 20,
    "edit_debounce_ms": 350,
    "show_background": false,
    "enabled": true
  },
  "show_whitespaces": "selection",
  "use_auto_surround": false,
  "indent_guides": {
    "background_coloring": "disabled",
    "coloring": "fixed",
    "active_line_width": 2,
    "line_width": 1
  },
  "hard_tabs": false,
  "toolbar": {
    "selections_menu": true,
    "quick_actions": false,
    "breadcrumbs": false
  },
  "minimap": {
    "show": "never"
  },
  "scrollbar": {
    "axes": {
      "horizontal": false
    },
    "show": "always",
    "git_diff": false,
    "cursors": false
  },
  "gutter": {
    "min_line_number_digits": 3,
    "runnables": false
  },
  "relative_line_numbers": "enabled",
  "drag_and_drop_selection": {
    "enabled": false
  },
  "hover_popover_delay": 200,
  "auto_signature_help": false,
  "horizontal_scroll_margin": 6.0,
  "vim_mode": true,
  "ui_font_family": "Hack Nerd Font",
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 400.0,
  "buffer_font_family": "FiraCode Nerd Font",
  "icon_theme": "Catppuccin Mocha",
  "telemetry": {
    "diagnostics": false,
    "metrics": true
  },
  "restore_on_startup": "none",
  "use_system_prompts": false,
  "when_closing_with_no_tabs": "keep_window_open",
  "ui_font_size": 16,
  "buffer_font_size": 15.0,
  "theme": "Gruvbox Dark",
  "buffer_font_features": {
    "calt": true
  },
  // "experimental.theme_overrides": {
  //   "background.appearance": "transparent",
  //   "background": "#101014a9",
  //   "panel.background": "#00000000",
  //   "editor.background": "#00000000",
