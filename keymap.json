[
    {
        "context": "Workspace",
        "bindings": {
            "ctrl-/": "terminal_panel::Toggle"
        }
    },
    {
        "context": "Editor",
        "bindings": {
            "ctrl-/": "terminal_panel::Toggle"
        }
    },
    {
        "context": "VimControl && !menu && !Terminal",
        "bindings": {
            "i": [
                "vim::PushObject",
                {
                    "around": false
                }
            ],
            "a": [
                "vim::PushObject",
                {
                    "around": true
                }
            ],
            "cmd-shift-p": "command_palette::Toggle",
            "shift-h": "pane::ActivatePreviousItem",
            "shift-l": "pane::ActivateNextItem",
            "] b": "pane::ActivateNextItem",
            "[ b": "pane::ActivatePreviousItem",
            "backspace": "vim::WrappingLeft",
            "enter": "menu::Confirm",
            "tab": "vim::Tab",
            "left": "vim::Left",
            "h": "vim::Left",
            "down": "vim::Down",
            "j": "vim::Down",
            "up": "vim::Up",
            "k": "vim::Up",
            "right": "vim::Right",
            "l": "vim::Right",
            "$": "vim::EndOfLine",
            "^": "vim::FirstNonWhitespace",
            "shift-g": "vim::EndOfDocument",
            "{": "vim::StartOfParagraph",
            "}": "vim::EndOfParagraph",
            "(": "vim::SentenceBackward",
            ")": "vim::SentenceForward",
            "|": "vim::GoToColumn",
            "w": "vim::NextWordStart",
            "e": "vim::NextWordEnd",
            "b": "vim::PreviousWordStart",
            "shift-w": [
                "vim::NextWordStart",
                {
                    "ignore_punctuation": true
                }
            ],
            "shift-e": [
                "vim::NextWordEnd",
                {
                    "ignore_punctuation": true
                }
            ],
            "shift-b": [
                "vim::PreviousWordStart",
                {
                    "ignore_punctuation": true
                }
            ],
            "g shift-e": [
                "vim::PreviousWordEnd",
                {
                    "ignore_punctuation": true
                }
            ],
            "/": "vim::Search",
            "space s g": "pane::DeploySearch",
            "space f p": "projects::OpenRecent",
            "space p": "projects::OpenRecent",
            // LazyVim default leader keymaps
            "space space": "file_finder::Toggle",
            "space f f": "file_finder::Toggle",
            "space f n": "workspace::NewFile",
            "space f t": "terminal_panel::Toggle",
            "space f c": "zed::OpenSettingsFile",
            "space f b": "tab_switcher::Toggle",
            "space e": "workspace::ToggleLeftDock",
            "space /": "pane::DeploySearch",
            "?": [
                "vim::Search",
                {
                    "backwards": true
                }
            ],
            "n": "vim::MoveToNextMatch",
            "shift-n": "vim::MoveToPreviousMatch",
            "%": [
                "vim::Matching",
                {
                    "match_quotes": true
                }
            ],
            "f": [
                "vim::PushFindForward",
                {
                    "before": false,
                    "multiline": true
                }
            ],
            "t": [
                "vim::PushFindForward",
                {
                    "before": true,
                    "multiline": true
                }
            ],
            "shift-f": [
                "vim::PushFindBackward",
                {
                    "after": false,
                    "multiline": true
                }
            ],
            "shift-t": [
                "vim::PushFindBackward",
                {
                    "after": true,
                    "multiline": true
                }
            ],
            "m": "vim::PushMark",
            "'": [
                "vim::PushJump",
                {
                    "line": true
                }
            ],
            "`": [
                "vim::PushJump",
                {
                    "line": false
                }
            ],
            ";": "vim::RepeatFind",
            ",": "vim::RepeatFindReversed",
            // ctrl-o / ctrl-i already do GoBack / GoForward via Zed's built-in vim keymap
            "escape": "vim::SwitchToNormalMode",
            "v": "vim::ToggleVisual",
            "shift-v": "vim::ToggleVisualLine",
            "ctrl-v": "editor::Paste",
            "shift-k": "editor::Hover",
            "shift-r": "vim::ToggleReplace",
            "0": "vim::StartOfLine",
            "ctrl-d": "vim::ScrollDown",
            "ctrl-u": "vim::ScrollUp",
            "space c r": "editor::Rename",
            "g r": "editor::FindAllReferences",
            "space c a": "editor::ToggleCodeActions",
            "g shift-i": "editor::GoToImplementation",
            "g g": "vim::StartOfDocument",
            "space g b": "editor::BlameHover",
            "space g g": "git_panel::ToggleFocus",
            "] h": "editor::GoToHunk",
            "[ h": "editor::GoToPreviousHunk",
            "] d": "editor::GoToDiagnostic",
            "[ d": "editor::GoToPreviousDiagnostic",
            "g d": "editor::GoToDefinition",
            "g shift-d": "editor::GoToDeclaration",
            "g y": "editor::GoToTypeDefinition",
            "g f": "editor::OpenSelectedFilename",
            "g shift-k": "editor::ShowSignatureHelp",
            "g shift-o": "outline::Toggle",
            "g n": "vim::SelectNextMatch",
            "g shift-n": "vim::SelectPreviousMatch",
            // gitsigns.nvim (gh prefix)
            "g h shift-b": "git::Blame",
            "g h d": "git::Diff",
            "g h shift-d": "git::ReviewDiff",
            "g h shift-r": "git::RestoreFile",
            "g h r": "git::Restore",
            "g h s": "git::ToggleStaged",
            "g h shift-s": "git::StageFile",
            "g h u": "git::UnstageFile",
            "space s s": "outline::Toggle",
            "space s shift-s": "project_symbols::Toggle",
            "space s r": [
                "pane::DeploySearch",
                {
                    "replace_enabled": true
                }
            ],
            "space s k": "zed::OpenKeymap",
            "space s b": "go_to_line::Toggle",
            "space s d": "diagnostics::Deploy",
            "space s shift-r": "workspace::ReopenLastPicker",
            "space c f": "editor::Format",
            "space c l": "lsp_tool::ToggleMenu",
            "space c p": "markdown::OpenPreview",
            "space x x": "diagnostics::Deploy",
            "space q q": "workspace::CloseWindow",
            // git (Snacks-style leader g, beyond blame/lazygit)
            "space g d": "git::Diff",
            "space g shift-d": "git::ReviewDiff",
            "space g s": "git_panel::ActivateChangesTab",
            "space g shift-s": "git_picker::ActivateStashTab",
            "space g l": "git_panel::ActivateHistoryTab",
            // debug (nvim-dap)
            "space d b": "editor::ToggleBreakpoint",
            "space d shift-b": "editor::EditLogBreakpoint",
            "space d c": "debugger::Continue",
            "space d i": "debugger::StepInto",
            "space d o": "debugger::StepOut",
            "space d shift-o": "debugger::StepOver",
            "space d shift-p": "debugger::Pause",
            "space d t": "debugger::Stop",
            "space d l": "debugger::Restart",
            "space d r": "debug_panel::ToggleFocus",
            "space d u": "debug_panel::ToggleFocus",
            "space d s": "debugger::ToggleSessionPicker",
            "space d w": "debugger::ToggleExpandItem",
            "space d e": "console::WatchExpression",
            // custom leader keymaps ported from nvim config
            "space shift-e": "workspace::ToggleLeftDock",
            "space t": "theme_selector::Toggle",
            "space c g": "agent::ToggleFocus",
            "space r": "task::Spawn",
            // UI toggles (<leader>u) — most LazyVim toggles here are settings.json-only in Zed;
            // these are the ones that have a real runtime action to bind
            "space u shift-c": "theme_selector::Toggle",
            "space u b": "theme::ToggleMode",
            "space u h": "editor::ToggleInlayHints",
            "space u l": "editor::ToggleLineNumbers",
            "space u w": "editor::ToggleSoftWrap",
            "space u z": "workspace::ToggleAllDocks",
            "space u shift-z": "vim::MaximizePane",
            "q": "vim::ToggleRecord",
            "shift-q": "vim::ReplayLastRecording",
            "@": "vim::PushReplayRegister",
            // z commands
            "z enter": [
                "workspace::SendKeystrokes",
                "z t ^"
            ],
            "z t": [
                "workspace::SendKeystrokes",
                "z t ^"
            ],
            "z b": "editor::ScrollCursorBottom",
            "z a": "editor::ToggleFold",
            "z shift-a": "editor::ToggleFoldRecursive",
            "z o": "editor::UnfoldLines",
            "z shift-o": "editor::UnfoldRecursive",
            "z f": "editor::FoldSelectedRanges",
            "z shift-m": "editor::FoldAll",
            "z shift-r": "editor::UnfoldAll",
            "z shift-l": "vim::HalfPageRight",
            "z shift-h": "vim::HalfPageLeft",
            // Count support
            "1": [
                "vim::Number",
                1
            ],
            "2": [
                "vim::Number",
                2
            ],
            "3": [
                "vim::Number",
                3
            ],
            "4": [
                "vim::Number",
                4
            ],
            "5": [
                "vim::Number",
                5
            ],
            "6": [
                "vim::Number",
                6
            ],
            "7": [
                "vim::Number",
                7
            ],
            "8": [
                "vim::Number",
                8
            ],
            "9": [
                "vim::Number",
                9
            ],
            ".": "vim::Repeat"
        }
    },
    {
        "context": "vim_mode == normal",
        "bindings": {
            "space w v": "pane::SplitVertical",
            "space w s": "pane::SplitHorizontal",
            "space w d": "pane::CloseActiveItem",
            "space w m": "vim::MaximizePane",
            "space b d": "pane::CloseActiveItem",
            "space b o": "pane::CloseOtherItems",
            "space b b": "pane::AlternateFile",
            "space b j": "tab_switcher::Toggle",
            "space b p": "pane::TogglePinTab",
            "space b shift-p": [
                "pane::CloseAllItems",
                {
                    "close_pinned": false
                }
            ],
            "space b r": [
                "pane::CloseItemsToTheRight",
                {
                    "close_pinned": false
                }
            ],
            "space b l": [
                "pane::CloseItemsToTheLeft",
                {
                    "close_pinned": false
                }
            ],
            "space ,": "tab_switcher::ToggleAll",
            "enter": "vim::NextLineStart",
            "g c c": "vim::ToggleComments",
            "i": "vim::InsertBefore",
            "a": "vim::InsertAfter",
            ":": "command_palette::Toggle",
            "c": "vim::PushChange",
            "shift-c": "vim::ChangeToEndOfLine",
            "d": "vim::PushDelete",
            "delete": "vim::DeleteRight",
            "y": "vim::PushYank",
            "x": "vim::DeleteRight",
            "ctrl-a": "vim::Increment",
            "ctrl-x": "vim::Decrement",
            "ctrl-r": "vim::Redo",
            ">": "vim::PushIndent",
            "<": "vim::PushOutdent",
            "=": "vim::PushAutoIndent",
            "!": "vim::PushShellCommand",
            "g u": "vim::PushLowercase",
            "g shift-u": "vim::PushUppercase",
            "g ~": "vim::PushOppositeCase",
            "g ?": "vim::PushRot13"
            // "g ?": "vim::PushRot47",
        }
    },
    {
        "context": "VimControl && VimCount",
        "bindings": {
            "0": [
                "vim::Number",
                0
            ],
            ":": "vim::CountCommand",
            "%": "vim::GoToPercentage"
        }
    },
    {
        "context": "vim_mode == visual",
        "bindings": {
            ":": "vim::VisualCommand",
            "d": "vim::VisualDelete",
            "x": "vim::VisualDelete",
            "backspace": "vim::VisualDelete",
            "delete": "vim::VisualDelete",
            "shift-d": "vim::VisualDeleteLine",
            "y": "vim::VisualYank",
            "shift-y": "vim::VisualYankLine",
            "p": "vim::Paste",
            "shift-p": [
                "vim::Paste",
                {
                    "preserve_clipboard": true
                }
            ],
            "c": "vim::Substitute",
            "shift-r": "vim::SubstituteLine",
            "~": "vim::ChangeCase",
            "ctrl-a": "vim::Increment",
            "cmd-c": "editor::Copy",
            "cmd-v": "editor::Paste",
            "ctrl-x": "vim::Decrement",
            "shift-i": "vim::InsertBefore",
            "shift-a": "vim::InsertAfter",
            "shift-j": "vim::JoinLines",
            "r": "vim::PushReplace",
            "s": [
                "vim::PushSneak",
                {}
            ],
            "escape": "vim::SwitchToNormalMode",
            ">": "vim::Indent",
            "<": "vim::Outdent",
            "i": [
                "vim::PushObject",
                {
                    "around": false
                }
            ],
            "a": [
                "vim::PushObject",
                {
                    "around": true
                }
            ],
            "g c": "vim::ToggleComments",
            "\"": "vim::PushRegister"
        }
    },
    {
        "context": "Editor && vim_mode == insert && !menu",
        "bindings": {
            "enter": "editor::Newline",
            "backspace": "editor::Backspace",
            "escape": "vim::NormalBefore",
            "ctrl-c": "editor::Copy",
            "ctrl-v": "editor::Paste"
        }
    },
    {
        "context": "showing_completions",
        "bindings": {
            "ctrl-j": "editor::ContextMenuNext",
            "ctrl-k": "editor::ContextMenuPrevious"
        }
    },
    {
        "context": "vim_mode == normal && !menu",
        "bindings": {
            "escape": "editor::Cancel",
            "shift-d": "vim::DeleteToEndOfLine",
            "shift-j": "vim::JoinLines",
            "shift-y": "vim::YankLine",
            "shift-i": "vim::InsertFirstNonWhitespace",
            "shift-a": "vim::InsertEndOfLine",
            "o": "vim::InsertLineBelow",
            "shift-o": "vim::InsertLineAbove",
            "~": "vim::ChangeCase",
            "ctrl-a": "vim::Increment",
            "ctrl-x": "vim::Decrement",
            "p": "vim::Paste",
            "shift-p": [
                "vim::Paste",
                {
                    "before": true
                }
            ],
            "u": "vim::Undo",
            "shift-u": "vim::UndoLastLine",
            "r": "vim::PushReplace",
            // flash.nvim equivalent: Zed's built-in Sneak motion (s/S override vim's substitute char/line,
            // same tradeoff flash.nvim makes in the real nvim config - use "cl"/"cc" for substitute instead)
            "s": [
                "vim::PushSneak",
                {}
            ],
            "shift-s": [
                "vim::PushSneakBackward",
                {}
            ],
            "\"": "vim::PushRegister",
            "ctrl-pagedown": "pane::ActivateNextItem",
            "ctrl-pageup": "pane::ActivatePreviousItem"
        }
    },
    {
        "context": "vim_mode == insert && !(showing_code_actions || showing_completions)",
        "bindings": {
            "ctrl-p": "editor::ShowWordCompletions",
            "ctrl-n": "editor::ShowWordCompletions"
        }
    },
    {
        "context": "(vim_mode == insert || vim_mode == normal) && showing_signature_help && !showing_completions",
        "bindings": {
            "ctrl-p": "editor::SignatureHelpPrevious",
            "ctrl-n": "editor::SignatureHelpNext"
        }
    },
    {
        "context": "vim_mode == replace",
        "bindings": {
            "ctrl-c": "editor::Copy",
            "ctrl-[": "vim::NormalBefore",
            "escape": "vim::NormalBefore",
            "ctrl-k": [
                "vim::PushDigraph",
                {}
            ],
            "ctrl-v": "editor::Paste",
            "ctrl-shift-v": "editor::Paste",
            "ctrl-q": [
                "vim::PushLiteral",
                {}
            ],
            "ctrl-shift-q": [
                "vim::PushLiteral",
                {}
            ],
            "backspace": "vim::UndoReplace",
            "tab": "vim::Tab",
            "enter": "vim::Enter",
            "insert": "vim::InsertBefore"
        }
    },
    {
        "context": "vim_mode == waiting",
        "bindings": {
            "tab": "vim::Tab",
            "enter": "vim::Enter",
            "s": [
                "vim::PushSneak",
                {}
            ],
            "escape": "vim::ClearOperators",
            "ctrl-c": "editor::Copy",
            "ctrl-v": "editor::Paste",
        }
    },
    {
        "context": "Editor && vim_mode == waiting && (vim_operator == ys || vim_operator == cs)",
        "bindings": {
            "escape": "vim::SwitchToNormalMode"
        }
    },
    {
        "context": "vim_mode == operator",
        "bindings": {
            "ctrl-c": "editor::Copy",
            "ctrl-[": "vim::ClearOperators",
            "escape": "vim::ClearOperators",
            "g c": "vim::Comment"
        }
    },
    {
        "context": "vim_operator == a || vim_operator == i || vim_operator == cs",
        "bindings": {
            "w": "vim::Word",
            "shift-w": [
                "vim::Word",
                {
                    "ignore_punctuation": true
                }
            ],
            // Subword TextObject
            // "w": "vim::Subword",
            // "shift-w": ["vim::Subword", { "ignore_punctuation": true }],
            "t": "vim::Tag",
            "s": "vim::Sentence",
            "p": "vim::Paragraph",
            // plain Quotes/BackQuotes/DoubleQuotes require the cursor to already be
            // between the quotes; MiniQuotes adds mini.ai's "search the line, jump
            // to the nearest quote pair" behavior, so bind the real quote keys to it
            "'": "vim::MiniQuotes",
            "`": "vim::MiniQuotes",
            "\"": "vim::MiniQuotes",
            // "q": "vim::AnyQuotes",
            "q": "vim::MiniQuotes",
            "|": "vim::VerticalBars",
            "(": [
                "vim::Parentheses",
                {
                    "opening": true
                }
            ],
            ")": "vim::Parentheses",
            // mini.ai default: b = nearest of any bracket type, not just parens
            "b": "vim::MiniBrackets",
            "[": [
                "vim::SquareBrackets",
                {
                    "opening": true
                }
            ],
            "]": "vim::SquareBrackets",
            "r": "vim::SquareBrackets",
            "{": [
                "vim::CurlyBrackets",
                {
                    "opening": true
                }
            ],
            "}": "vim::CurlyBrackets",
            "shift-b": "vim::CurlyBrackets",
            "<": [
                "vim::AngleBrackets",
                {
                    "opening": true
                }
            ],
            ">": "vim::AngleBrackets",
            "a": "vim::Argument",
            "i": "vim::IndentObj",
            "shift-i": [
                "vim::IndentObj",
                {
                    "include_below": true
                }
            ],
            "f": "vim::Method",
            "c": "vim::Class",
            // mini.ai custom_textobjects: e = word-with-case (subword), g = entire buffer
            "e": "vim::Subword",
            "g": "vim::EntireFile"
        }
    },
    {
        "context": "vim_operator == c",
        "bindings": {
            "c": "vim::CurrentLine",
            "x": "vim::Exchange",
            "d": "editor::Rename", // zed specific
            "s": [
                "vim::PushChangeSurrounds",
                {}
            ]
        }
    },
    {
        "context": "vim_operator == d",
        "bindings": {
            "d": "vim::CurrentLine",
            "s": "vim::PushDeleteSurrounds",
            "v": "vim::PushForcedMotion", // "d v"
            "o": "editor::ToggleSelectedDiffHunks", // "d o"
            "shift-o": "git::ToggleStaged",
            "p": "git::Restore", // "d p"
            "u": "git::StageAndNext", // "d u"
            "shift-u": "git::UnstageAndNext" // "d shift-u"
        }
    },
    {
        "context": "vim_operator == gu",
        "bindings": {
            "g u": "vim::CurrentLine",
            "u": "vim::CurrentLine"
        }
    },
    {
        "context": "vim_operator == gU",
        "bindings": {
            "g shift-u": "vim::CurrentLine",
            "shift-u": "vim::CurrentLine"
        }
    },
    {
        "context": "vim_operator == g~",
        "bindings": {
            "g ~": "vim::CurrentLine",
            "~": "vim::CurrentLine"
        }
    },
    {
        "context": "vim_operator == g?",
        "bindings": {
            "g ?": "vim::CurrentLine",
            "?": "vim::CurrentLine"
        }
    },
    {
        "context": "vim_operator == gq",
        "bindings": {
            "g q": "vim::CurrentLine",
            "q": "vim::CurrentLine",
            "g w": "vim::CurrentLine",
            "w": "vim::CurrentLine"
        }
    },
    {
        "context": "vim_operator == y",
        "bindings": {
            "y": "vim::CurrentLine",
            "v": "vim::PushForcedMotion",
            "s": [
                "vim::PushAddSurrounds",
                {}
            ]
        }
    },
    {
        "context": "vim_operator == ys",
        "bindings": {
            "s": "vim::CurrentLine"
        }
    },
    {
        "context": "vim_operator == >",
        "bindings": {
            ">": "vim::CurrentLine"
        }
    },
    {
        "context": "vim_operator == <",
        "bindings": {
            "<": "vim::CurrentLine"
        }
    },
    {
        "context": "vim_operator == eq",
        "bindings": {
            "=": "vim::CurrentLine"
        }
    },
    {
        "context": "vim_operator == sh",
        "bindings": {
            "!": "vim::CurrentLine"
        }
    },
    {
        "context": "vim_operator == gc",
        "bindings": {
            "c": "vim::CurrentLine"
        }
    },
    {
        "context": "vim_operator == gR",
        "bindings": {
            "r": "vim::CurrentLine",
            "shift-r": "vim::CurrentLine"
        }
    },
    {
        "context": "vim_operator == cx",
        "bindings": {
            "x": "vim::CurrentLine",
            "c": "vim::ClearExchange"
        }
    },
    {
        "context": "vim_mode == literal",
        "bindings": {
            "ctrl-@": [
                "vim::Literal",
                [
                    "ctrl-@",
                    "\u0000"
                ]
            ],
            "ctrl-a": [
                "vim::Literal",
                [
                    "ctrl-a",
                    "\u0001"
                ]
            ],
            "ctrl-b": [
                "vim::Literal",
                [
                    "ctrl-b",
                    "\u0002"
                ]
            ],
            "ctrl-c": [
                "vim::Literal",
                [
                    "ctrl-c",
                    "\u0003"
                ]
            ],
            "ctrl-d": [
                "vim::Literal",
                [
                    "ctrl-d",
                    "\u0004"
                ]
            ],
            "ctrl-e": [
                "vim::Literal",
                [
                    "ctrl-e",
                    "\u0005"
                ]
            ],
            "ctrl-f": [
                "vim::Literal",
                [
                    "ctrl-f",
                    "\u0006"
                ]
            ],
            "ctrl-g": [
                "vim::Literal",
                [
                    "ctrl-g",
                    "\u0007"
                ]
            ],
            "ctrl-h": [
                "vim::Literal",
                [
                    "ctrl-h",
                    "\u0008"
                ]
            ],
            "ctrl-i": [
                "vim::Literal",
                [
                    "ctrl-i",
                    "\u0009"
                ]
            ],
            "ctrl-j": [
                "vim::Literal",
                [
                    "ctrl-j",
                    "\u000A"
                ]
            ],
            "ctrl-k": [
                "vim::Literal",
                [
                    "ctrl-k",
                    "\u000B"
                ]
            ],
            "ctrl-l": [
                "vim::Literal",
                [
                    "ctrl-l",
                    "\u000C"
                ]
            ],
            "ctrl-m": [
                "vim::Literal",
                [
                    "ctrl-m",
                    "\u000D"
                ]
            ],
            "ctrl-n": [
                "vim::Literal",
                [
                    "ctrl-n",
                    "\u000E"
                ]
            ],
            "ctrl-o": [
                "vim::Literal",
                [
                    "ctrl-o",
                    "\u000F"
                ]
            ],
            "ctrl-p": [
