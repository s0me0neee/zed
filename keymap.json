    {
        // direct pane navigation (no ctrl-w prefix), works everywhere including the terminal
        // (this overrides the shell's ctrl-h backspace, ctrl-j enter, ctrl-k kill-line, ctrl-l clear-screen)
        "context": "VimControl && !menu || !Editor",
        "bindings": {
            "ctrl-h": "workspace::ActivatePaneLeft",
            "ctrl-j": "workspace::ActivatePaneDown",
            "ctrl-k": "workspace::ActivatePaneUp",
            "ctrl-l": "workspace::ActivatePaneRight"
        }
    },
